# Copy to .env.local and fill in whichever providers you actually use.
# Foundry runs offline-first — leave any of these blank to skip that provider.

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Inception Mercury (diffusion LLM, OpenAI-compatible)
MERCURY_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-coder-small

# Local LMStudio (OpenAI-compatible, default localhost:1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=local-model

# Generic OpenAI-compatible (Ollama, vLLM, OpenAI proper, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
